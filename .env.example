# 后端环境变量示例
# ------------------------------------------------------------------
# 复制为 .env 只是给人看的说明；实际请用系统环境变量或进程管理器注入。
# 本项目后端只读 process.env，不会自动加载 .env 文件（避免引入额外依赖）。
#
# 方式一：直接在命令行里设置（Windows PowerShell）
#   $env:LLM_API_KEY="sk-xxx"; $env:LLM_BASE_URL="https://api.deepseek.com/anthropic"; node server/index.mjs
#
# 方式二：Linux / macOS
#   LLM_API_KEY=sk-xxx LLM_BASE_URL=https://api.deepseek.com/anthropic node server/index.mjs
#
# 注意：密钥只放在服务端，不要写进前端代码或提交到仓库。

# 模型密钥（必填）
LLM_API_KEY=

# 接口地址（必填）
# Anthropic 风格（默认）：https://api.deepseek.com/anthropic 或 https://api.anthropic.com
# OpenAI 风格：把 LLM_API_STYLE 设为 openai，并填写 .../v1 的上级地址
LLM_BASE_URL=

# 接口风格：anthropic（默认）| openai
LLM_API_STYLE=anthropic

# 模型名（可选，缺省用平台注入的 ANTHROPIC_MODEL）
LLM_MODEL=

# 服务端口（可选，默认 8787）
PORT=8787

# /api/* 访问口令（可选）。设置后前端需要在「运行设置」里填同样的口令。
API_ACCESS_TOKEN=

# 允许跨域的来源（可选，默认 *；上线建议收紧为前端站点域名）
ALLOW_ORIGIN=

# 单次送入模型的正文上限（字符，可选，默认 90000）
MAX_PAPER_CHARS=90000
